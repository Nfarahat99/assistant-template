{
  "name": "assistant-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "قالب مساعد شخصي على واتساب وتيليجرام — مهام، تذكيرات، رسائل، وتعديلات كود بموافقة المالك",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./src/test-setup.ts --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "eval": "tsx --import ./src/test-setup.ts src/evals/run.ts",
    "prestart": "node scripts/version.mjs",
    "predev": "node scripts/version.mjs",
    "doctor": "tsx scripts/doctor.mjs",
    "telegram-link": "tsx scripts/telegram-link.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "assistantTemplate": {
    "onboardingContract": 1
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/static": "^10.1.5",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
