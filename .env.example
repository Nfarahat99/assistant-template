# ===== قاعدة البيانات =====
# اتركه فارغاً محلياً => PGlite المدمج في .data/pg
# على ريلواي: يُملأ تلقائياً من إضافة Postgres
DATABASE_URL=
PGLITE_DIR=./.data/pg
# مجلد ملفات المستندات — على ريلواي اربطه بـ Volume
FILES_DIR=./.data/files

PORT=3000
TZ=Asia/Riyadh
LOG_LEVEL=info

# ===== واتساب (اختياري) =====
# بدون متغيرات GATEWAY_* يعمل المساعد على تيليجرام فقط (و/health يعرض wa: disabled)
# ===== الويبهوك من وسيط واتساب =====
# نفس القيمة التي تضعها في PUT {GATEWAY_URL}/api/v1/webhook (حقل secret)
WEBHOOK_SECRET=

# ===== وسيط واتساب (الإرسال) =====
# فارغة عمداً: واتساب يبقى معطّلاً حتى تملأ GATEWAY_URL وGATEWAY_API_KEY وASSISTANT_PHONE (تيليجرام وحده يعمل بدونها).
# مثال القيم: GATEWAY_URL=https://your-gateway.example.com | GATEWAY_API_KEY=wm_... | ASSISTANT_PHONE=9665XXXXXXXX
GATEWAY_URL=
# الطريقة الأسهل: اربط من اللوحة ← الحسابات. تحتاج GATEWAY_URL + GATEWAY_PROVISION_KEY + SECRETS_KEY + WEBHOOK_SECRET (16 حرفاً+) + رابط عام (PUBLIC_URL)،
# وتترك GATEWAY_API_KEY وASSISTANT_PHONE فارغين (اللوحة تحفظ مفتاح الرقم مشفّراً). بعد الربط يعيد المساعد تشغيل نفسه (exit 75).
GATEWAY_PROVISION_KEY=            # مفتاح التسجيل (provision) من الوسيط — يسمح للمساعد يسجّل رقمه بنفسه
GATEWAY_API_KEY=                  # من لوحة الوسيط ← مفاتيح API (يُفضّل مقيّداً برقم المساعد)
ASSISTANT_PHONE=                  # رقم المساعد المربوط في الوسيط (منه تُرسل كل الرسائل)
OWNER_PHONE=                      # رقمك أنت — الوحيد الذي يُطاع (بصيغة 9665XXXXXXXX)
OWNER_SIGNATURE=                  # يُلحق برسائل الطرف الثالث في وضع direct فقط — فارغ = signature من assistant.config.json
# مفتاح تشفير 64 خانة hex — ولّده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" — لازم لربط الواتساب من اللوحة
SECRETS_KEY=

# ===== إرسال الرسائل للناس =====
# link (الافتراضي والموصى به): رقم البوت يكلّمك أنت فقط. الرسالة لأي شخص تصلك كرابط wa.me
#   تضغطه وترسلها من رقمك. (الرقم حُظر سابقاً بعد أول رسالة لغريب.)
# direct: البوت يرسل بنفسه — فقط لمن راسل البوت خلال ٢٤ ساعة. خطر حظر.
THIRD_PARTY_SEND_MODE=link
# أرقام (مفصولة بفاصلة) مستثناة من وضع link — يرسل لها البوت مباشرة. فارغ = direct_send_allowlist من assistant.config.json
DIRECT_SEND_ALLOWLIST=

# ===== تيليجرام (قناة ثانية + احتياط تلقائي) =====
TELEGRAM_BOT_TOKEN=               # من @BotFather
TELEGRAM_OWNER_CHAT_ID=           # اختياري — وإلا أرسل للبوت: /start <TELEGRAM_LINK_CODE>
TELEGRAM_LINK_CODE=               # سر عشوائي: openssl rand -hex 12
PUBLIC_URL=                       # رابط البوت العام للويبهوك؛ على ريلواي يُؤخذ من RAILWAY_PUBLIC_DOMAIN تلقائياً. فارغ = long polling
TELEGRAM_WEBHOOK_SECRET=          # اختياري — يُشتق من التوكن إن تُرك
TELEGRAM_WEBHOOK_PATH=            # اختياري — يُشتق من التوكن إن تُرك
DEFAULT_COUNTRY_CODE=966

# ===== تنبيهات الانقطاع عبر ntfy (اختياري — تيليجرام مفضّل إن رُبط) =====
# ثبّت تطبيق ntfy على جوالك الشخصي واشترك في نفس الموضوع. الموضوع = سر: ولّده عشوائياً
#   مثل: openssl rand -hex 16  ← <اسم-مساعدك>-<الناتج>
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh          # غيّره فقط لو استضفت ntfy بنفسك
GATEWAY_DASHBOARD_URL=            # رابط لوحة الوسيط في التنبيه؛ فارغ = GATEWAY_URL

# ===== الذكاء (مجاني) =====
# Gemini إلزامي. Groq اختياري تماماً (غير متاح من السعودية) — اتركه فارغاً:
# عندها الصوتية تُفرّغ وتُفهم في استدعاء Gemini واحد، ولا محاولات Groq إطلاقاً.
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash     # الفهم (+ الصوت المباشر بدون Groq)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite   # عند 429/5xx من الأساسي — فارغ = بلا احتياط
GROQ_API_KEY=                     # اختياري: https://console.groq.com/keys
STT_MODEL=whisper-large-v3-turbo  # Groq Whisper (فقط إن وُجد GROQ_API_KEY)
STT_FALLBACK_MODEL=gemini-3.8-flash   # تفريغ Gemini عند فشل Groq
LLM_PROVIDER=                    # فارغ = Nvidia أساسي إن وُجد NVIDIA_API_KEY وإلا Gemini؛ أو gemini | groq | nvidia — الباقي احتياط
NVIDIA_API_KEY=                   # اختياري: https://build.nvidia.com — مع LLM_PROVIDER=nvidia يصبح أساسياً وGemini احتياط تلقائي
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
ANTHROPIC_API_KEY=                # اختياري: https://console.anthropic.com — يُفعَّل Claude لكل دور من لوحة التحكم (النموذج الافتراضي claude-opus-5-5)
OPENAI_API_KEY=                   # اختياري: مفتاح أي مزوّد متوافق مع OpenAI (OpenRouter، Together، OpenAI…) — يُختار لكل دور من اللوحة
OPENAI_BASE_URL=                  # اختياري: عنوان المزوّد المتوافق (فارغ = https://api.openai.com/v1)
LLM_UNDERSTAND_PROVIDER=          # اختياري (قديم): gemini | nvidia — الافتراضي الأولي لدور «الفهم» وحده (يُطبَّق إن وُجد مفتاح المزوّد)؛ بعد أول حفظ لإعدادات اللوحة تُحفظ الأدوار وتعلو عليه
EVAL_MIN_SCORE=                   # اختياري: npm run eval يفشل (exit 1) تحت هذه الدرجة %
LLM_MODEL=                        # يعلو على نموذج المزوّد الأساسي؛ فارغ = الافتراضي
GROQ_MODEL=openai/gpt-oss-120b

# ===== GitHub (تعديلات الكود) =====
# Fine-grained PAT: Actions RW + Contents RW + Pull requests RW على مستودعاتك
GITHUB_TOKEN=
GITHUB_WORKFLOW=claude.yml
PROJECTS_FILE=./projects.json
PROJECTS_REMOTE=                  # owner/repo/path — يُحمّل عند الإقلاع وعند "حدث المشاريع" — فارغ = github.projects_remote من assistant.config.json، وإلا لا تحميل بعيد
# مستودعات مرتبطة (خلل في أحدها يمس الآخر) — JSON: [{"repos":["owner/a","owner/b"],"words":["…"],"note":"…"}]
LINKED_REPOS=

# ===== Railway (قراءة الحالة + إعادة نشر بموافقة صريحة) =====
RAILWAY_API_TOKEN=                # Account/Workspace token من https://railway.com/account/tokens
RAILWAY_WORKSPACE_ID=             # اختياري: معرّف مساحة العمل في ريلواي

# ===== لوحة التحكم =====
DASHBOARD_PASSWORD=               # كلمة مرور اللوحة (إلزامية للوصول إليها) — تغييرها يُبطل كل الجلسات

# ===== الملف الشخصي =====
ASSISTANT_CONFIG=./assistant.config.json   # مسار ملف الهوية؛ غيابه أو خطؤه = خروج برمز 1 برسالة واضحة
KNOWLEDGE_FILE=./knowledge/owner.md        # ملف معرفة المالك الذي يُحقن في الردود

# ===== بحث الويب والنماذج الإضافية =====
TAVILY_API_KEY=                   # اختياري: بحث الويب عبر Tavily
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # اختياري: عنوان Nvidia
VIDEO_TIMEOUT_MS=                 # اختياري: مهلة تحليل الفيديو بالملّي ثانية

# ===== بوابة CI لقواعد البيانات (اختياري) =====
CI_GATEWAY_SECRET=                # سر البوابة؛ فارغ = البوابة معطّلة. التوكن لكل مستودع = HMAC-SHA256(السر, repo)
CI_GATEWAY_SCOPES=                # JSON: {"owner/repo":["اسم-قاعدة"]} — يحلّ محل الخريطة الافتراضية
CI_GATEWAY_DISABLED_REPOS=        # مستودعات (مفصولة بفاصلة) تُحجب عنها البوابة
DB_MONITOR_IGNORE=                # مشاريع (مفصولة بفاصلة) تُستثنى من مراقبة قواعد البيانات

# ===== التقييم =====
EVAL_CONCURRENCY=2                # توازي npm run eval

# ===== المجدول =====
MORNING_BRIEF_AT=07:30
EVENING_REVIEW_AT=21:30

# ===== جهات الاتصال (اختياري) =====
# مسار ملف CSV أو النص نفسه. الصيغة: name,phone,aliases  (الأسماء البديلة مفصولة بـ |)
# مثال مباشر: CONTACTS_CSV=أحمد سالم,0500003456,أبو سالم|أحمد الشغل;;سامي,0500000000
CONTACTS_CSV=

# ===== حصة الذكاء (تنبيهات قبل النفاد) =====
# Google لا تعرض المتبقي — البوت يحسب محلياً. تحقق من حدودك في https://aistudio.google.com/rate-limit
GEMINI_DAILY_REQUEST_LIMIT={"gemini-3.8-flash":250,"gemini-3.5-flash-lite":1000}
GEMINI_DAILY_TOKEN_LIMIT=         # اختياري: {"gemini-3.8-flash":1000000} أو رقم واحد
LLM_BILLING=free                  # free = التكلفة الفعلية 0 (مع تقدير سعر القائمة) | paid
PRICES_JSON=                      # اختياري: استبدال أسعار القائمة {"model":{"in":0.75,"out":3.75,"audio_hour":0.04}}

# ===== نبض اللابتوب (هل اللابتوب شغال؟) =====
HEARTBEAT_TOKEN=                  # سر يرسله برنامج اللابتوب: POST /api/heartbeat  Authorization: Bearer <التوكن>

# ===== قواعد بيانات المشاريع من المحادثة =====
# DB_CONNECTIONS — JSON: [{"key":"falak","name_ar":"نبراس","aliases":[],"project":"falak","url":"postgresql://***","deny_tables":["auth_creds"]}]
# DB_CONNECTIONS=

# ===== قواعد بيانات المشاريع (قراءة فقط) =====
# PROJECT_DB_<الاسم>_URL — استعلام/فحص سجلات/مطابقة عبر لوحة التحكم (/api/dash/projectdb). يُنصح بدور Postgres بصلاحية SELECT فقط.
# مثال: PROJECT_DB_HUDOOR_URL=postgresql://readonly_user:***@host:5432/db
